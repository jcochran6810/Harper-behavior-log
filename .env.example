# Copy to .env.local for local development. In production these live in
# Vercel → Settings → Environment Variables.

# Supabase — the "Where's my note" project holds the harper_* tables.
SUPABASE_URL=https://puzwcsrtqtbutypzozvu.supabase.co
# Supabase dashboard → Project Settings → API keys → service_role (secret).
# This key bypasses row-level security. Server-side only; never expose it.
SUPABASE_SERVICE_ROLE_KEY=

# console.anthropic.com → API keys → Create key. Used to read the handwriting.
ANTHROPIC_API_KEY=

# The STARTING 4-digit code that unlocks the site. Once a PIN is set on the
# Settings page it is stored (hashed) in the database and this value is ignored.
APP_PIN=1234

# Random string used to sign the login cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
